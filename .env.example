# Twilio WhatsApp (Sandbox o Producción)
#
# 1) Crea cuenta Twilio
# 2) Activa WhatsApp Sandbox o configura un WhatsApp sender
# 3) Agrega estas variables en Vercel (Project -> Settings -> Environment Variables)

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# En sandbox normalmente es:
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Tu número destino (equipo) en formato WhatsApp:
# WHATSAPP_ADMIN_TO=whatsapp:+5215616191340
WHATSAPP_ADMIN_TO=

# Google Sheets (Apps Script Webhook)
# Crea un Apps Script como Web App que reciba POST y agregue una fila.
GOOGLE_SHEETS_WEBHOOK_URL=
# Opcional: token simple para evitar spam (se valida en Apps Script)
GOOGLE_SHEETS_WEBHOOK_TOKEN=
